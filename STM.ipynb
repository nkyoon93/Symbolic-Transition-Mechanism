NOISE_OUTPUT_DIRECTORY = Path("stm_results")
KNOWN_PERIODS = (4, 7, 12, 24, 48)
NOISE_LEVELS = (0.0, 0.05, 0.10, 0.25)
SYNTHETIC_LENGTH = 240
NOISE_SEEDS = tuple(range(1020, 1100))


def make_periodic_series(period, length, noise_std, seed):
    rng = np.random.default_rng(int(seed))
    block = rng.standard_normal(int(period))
    clean = np.tile(block, int(length) // int(period) + 1)[:int(length)]
    return clean + rng.normal(0, float(noise_std), int(length))


def evaluate_period_recovery(periods=KNOWN_PERIODS, noise_levels=NOISE_LEVELS, length=SYNTHETIC_LENGTH, seeds=NOISE_SEEDS):
    periods = tuple(int(period) for period in periods)
    noise_levels = tuple(float(noise) for noise in noise_levels)
    seeds = tuple(int(seed) for seed in seeds)
    if not periods or not noise_levels or not seeds:
        raise ValueError("Periods, noise levels, and seeds must be nonempty")
    if any(period < 2 or period > min(96, int(length) // 3) for period in periods):
        raise ValueError("Known periods must be within the detector candidate range")
    if any(not np.isfinite(noise) or noise < 0 for noise in noise_levels):
        raise ValueError("Noise levels must be finite and nonnegative")
    records = []
    for period in periods:
        for noise in noise_levels:
            for seed in seeds:
                series = make_periodic_series(period, length, noise, seed)
                stm = STM().fit(series)
                state = stm.compute(series)
                detected = state["period"]
                records.append({
                    "true_period": period,
                    "noise_std": noise,
                    "seed": seed,
                    "length": int(length),
                    "nominal_snr": np.inf if noise == 0 else 1.0 / noise ** 2,
                    "detected_period": detected,
                    "period_score": state["period_score"],
                    "accepted": detected is not None,
                    "exact_recovery": detected == period,
                })
    trials = pd.DataFrame(records)
    summary = trials.groupby(["true_period", "noise_std"], as_index=False).agg(
        sequences=("exact_recovery", "size"),
        exact_recovery_count=("exact_recovery", "sum"),
        exact_recovery_rate=("exact_recovery", "mean"),
        acceptance_rate=("accepted", "mean"),
    )
    summary["exact_recovery_percent"] = 100.0 * summary["exact_recovery_rate"]
    table = summary.pivot(index="true_period", columns="noise_std", values="exact_recovery_percent")
    table = table.reindex(index=list(periods), columns=list(noise_levels))
    table.loc["Mean"] = table.mean(axis=0)
    return trials, summary, table


def plot_period_recovery(table):
    figure, axis = plt.subplots(figsize=(7.2, 4.6), constrained_layout=True)
    noise = np.asarray(table.columns, dtype=float)
    for period in table.index:
        if period != "Mean":
            axis.plot(noise, table.loc[period].to_numpy(dtype=float), marker="o", linewidth=1.35, markersize=4, label=f"T = {period}")
    axis.plot(noise, table.loc["Mean"].to_numpy(dtype=float), color="#202833", marker="s", linestyle="--", linewidth=2.1, markersize=4.5, label="Mean")
    axis.set_xlabel("Gaussian noise standard deviation σ")
    axis.set_ylabel("Exact period recovery (%)")
    axis.set_title("Period detection under noise")
    axis.set_xticks(noise)
    axis.set_ylim(0, 105)
    axis.grid(alpha=0.2, linewidth=0.6)
    axis.spines["top"].set_visible(False)
    axis.spines["right"].set_visible(False)
    axis.legend(frameon=False, ncol=3, loc="lower left")
    return figure


def run_noise_evaluation():
    NOISE_OUTPUT_DIRECTORY.mkdir(parents=True, exist_ok=True)
    trials, summary, table = evaluate_period_recovery()
    trials.to_csv(NOISE_OUTPUT_DIRECTORY / "period_noise_trials.csv", index=False)
    summary.to_csv(NOISE_OUTPUT_DIRECTORY / "period_noise_summary.csv", index=False)
    table.to_csv(NOISE_OUTPUT_DIRECTORY / "period_noise_recovery.csv")
    display(table.round(2))
    figure = plot_period_recovery(table)
    for extension in ("png", "pdf"):
        figure.savefig(NOISE_OUTPUT_DIRECTORY / f"period_noise_recovery.{extension}", dpi=200, bbox_inches="tight")
    plt.show()
    plt.close(figure)
    return {"trials": trials, "summary": summary, "recovery_percent": table}


noise_evaluation = run_noise_evaluation()


def run_one_step_experiment():
    models = configured_models()
    if not models:
        return {
            "status": "configuration_required",
            "required_models": list(MODEL_LOCATIONS),
            "required_datasets": list(ONE_STEP_DATASETS),
        }
    bundles = {}
    missing_datasets = []
    errors = []
    for dataset_name in ONE_STEP_DATASETS:
        try:
            values = load_dataset(dataset_name)
            if values is None:
                missing_datasets.append(dataset_name)
                continue
            bundles[dataset_name] = prepare_windows(values, ONE_STEP_INPUT_LENGTH, 1, ONE_STEP_WINDOWS)
        except Exception as exc:
            errors.append({"dataset": dataset_name, "error": safe_error(exc)})
    if not bundles:
        return {
            "status": "configuration_required",
            "required_models": list(MODEL_LOCATIONS),
            "required_datasets": list(ONE_STEP_DATASETS),
            "missing_datasets": missing_datasets,
            "errors": errors,
        }
    results = []
    for model_name in models:
        tokenizer = None
        model = None
        try:
            tokenizer, model = load_frozen_model(model_name)
            for dataset_name, bundle in bundles.items():
                stm = STM().fit(bundle["train_scaled"])
                for variant in ("raw", "full_stm"):
                    predictions = []
                    parsed = []
                    for history in bundle["histories"]:
                        prediction, parsed_count = forecast_one_step(tokenizer, model, history, variant, stm, dataset_name)
                        predictions.append(prediction)
                        parsed.append(parsed_count)
                    predictions = np.asarray(predictions, dtype=float)
                    targets = bundle["targets"][:, 0]
                    predictions_original = inverse_scale(predictions, bundle["mean"], bundle["scale"])
                    targets_original = inverse_scale(targets, bundle["mean"], bundle["scale"])
                    results.append({
                        "dataset": dataset_name,
                        "model": model_name,
                        "variant": variant,
                        "test_origins": int(len(targets)),
                        "MAE": round(float(np.mean(np.abs(targets_original - predictions_original))), 8),
                        "MSE": round(float(np.mean((targets_original - predictions_original) ** 2)), 8),
                        "parsed_fraction": round(float(np.mean(parsed)), 8),
                    })
        except Exception as exc:
            errors.append({"model": model_name, "error": safe_error(exc)})
        finally:
            if tokenizer is not None and model is not None:
                release_model(tokenizer, model)
                tokenizer = None
                model = None
    return {
        "status": "ok" if results and not errors and not missing_datasets else "partial" if results else "failed",
        "protocol": {
            "input_length": ONE_STEP_INPUT_LENGTH,
            "horizon": 1,
            "test_origins": ONE_STEP_WINDOWS,
            "do_sample": False,
            "temperature_reported": REPORTED_TEMPERATURE,
            "top_p_reported": REPORTED_TOP_P,
        },
        "results": results,
        "missing_datasets": missing_datasets,
        "errors": errors,
    }


print("result:", run_one_step_experiment())


