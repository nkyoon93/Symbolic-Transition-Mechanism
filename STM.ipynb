ALPHA_NORMALIZE_FOR_PLOT = True


def describe_symbolic_transitions(stm, sequence):
    values = np.asarray(sequence, dtype=float).reshape(-1)
    if not len(values) or not np.isfinite(values).all():
        raise ValueError("The input sequence must contain finite values")
    state = stm.compute(values)
    symbols = np.asarray(state["symbols"], dtype=object)
    previous_symbols = np.concatenate(([None], symbols[:-1]))
    table = pd.DataFrame({
        "step": np.arange(len(values)),
        "normalized_value": values,
        "previous_symbol": previous_symbols,
        "symbol": symbols,
        "symbol_code": state["codes"],
        "delta": state["deltas"],
        "periodic_weight": state["periodic_weight"],
        "alpha_raw": state["alpha_raw"],
        "alpha_normalized": state["alpha"],
    })
    table["direction"] = np.where(table["delta"] > 0, "increase", np.where(table["delta"] < 0, "decrease", "unchanged"))
    table["period_weight_applied"] = table["periodic_weight"] > 1.0
    table["detected_period"] = state["period"]
    table["period_score"] = state["period_score"]
    return table


def plot_symbolic_profiles(profiles, normalize=ALPHA_NORMALIZE_FOR_PLOT):
    if not profiles:
        raise ValueError("No profiles are available")
    count = len(profiles)
    figure, axes = plt.subplots(3, count, figsize=(6.4 * count, 9.6), sharex="col", squeeze=False, constrained_layout=True)
    palette = np.asarray(["#335c81", "#4e9c9b", "#c9b458", "#d88b59", "#a44959"])
    names = {"JenaClimate": "Jena Climate", "AzureLLMTrace": "LLM traffic"}
    units = {"JenaClimate": "Temperature (°C)", "AzureLLMTrace": "Context tokens"}
    for column, (dataset_name, table) in enumerate(profiles.items()):
        steps = table["step"].to_numpy()
        deltas = table["delta"].to_numpy()
        symbol_codes = table["symbol_code"].to_numpy(dtype=int)
        weights = table["alpha_normalized" if normalize else "alpha_raw"].to_numpy()
        color = np.where(deltas > 0, "#4169c9", np.where(deltas < 0, "#d15c5c", "#7b8490"))
        top, middle, bottom = axes[:, column]
        top.plot(steps, table["value"], color="#345b9b", marker="o", markersize=3.5, linewidth=1.35)
        top.set_title(names.get(dataset_name, dataset_name), fontsize=13, fontweight="bold")
        top.set_ylabel(units.get(dataset_name, "Observed value"))
        middle.axhline(0, color="#a7adb4", linewidth=0.7)
        middle.vlines(steps, 0, deltas, color=color, linewidth=1.5)
        middle.scatter(steps, deltas, c=color, s=20, zorder=3)
        middle.set_ylabel("Symbolic transition δ")
        middle.set_yticks(np.arange(-4, 5))
        middle.set_ylim(-4.6, 4.6)
        middle.legend(handles=[
            Line2D([0], [0], color="#4169c9", label="Increase"),
            Line2D([0], [0], color="#d15c5c", label="Decrease"),
            Line2D([0], [0], color="#7b8490", label="Unchanged"),
        ], loc="upper right", fontsize=8, frameon=False)
        bars = bottom.bar(steps, weights, color=palette[symbol_codes], width=0.76, edgecolor="white", linewidth=0.4)
        maximum = max(float(np.max(weights)), 0.05)
        for bar, symbol in zip(bars, table["symbol"]):
            bottom.text(bar.get_x() + bar.get_width() / 2, bar.get_height() + maximum * 0.025, symbol, ha="center", va="bottom", fontsize=7)
        bottom.set_ylim(0, maximum * 1.3)
        bottom.set_ylabel("Normalized α" if normalize else "α")
        bottom.set_xlabel("Time step within input window")
        bottom.legend(handles=[Patch(facecolor=palette[i], label=symbol) for i, symbol in enumerate(("VL", "L", "M", "H", "VH"))], ncol=5, loc="upper right", fontsize=7, frameon=False)
        period = table["detected_period"].iloc[0]
        score = float(table["period_score"].iloc[0])
        period_label = f"No accepted period; best match: {score:.4f}" if pd.isna(period) else f"Detected period: {int(period)}; match score: {score:.4f}"
        bottom.set_title(period_label, fontsize=9)
        stride = max(1, int(np.ceil(len(steps) / 12)))
        bottom.set_xticks(steps[::stride])
        for axis in axes[:, column]:
            axis.grid(axis="y", alpha=0.18, linewidth=0.6)
            axis.set_axisbelow(True)
            axis.spines["top"].set_visible(False)
            axis.spines["right"].set_visible(False)
    return figure


def run_alpha_visualization(datasets=ALPHA_DATASETS, window_index=ALPHA_WINDOW_INDEX):
    window_index = None if window_index is None else int(window_index)
    if window_index is not None and not 0 <= window_index < INITIAL_TEST_ORIGINS:
        raise ValueError("The window index must be within the test-origin pool")
    OUTPUT_DIRECTORY.mkdir(parents=True, exist_ok=True)
    profiles = {}
    missing = []
    errors = []
    paths = []
    for dataset_name in datasets:
        try:
            values = load_dataset(dataset_name)
            if values is None:
                missing.append(dataset_name)
                continue
            requested_windows = INITIAL_TEST_ORIGINS if window_index is None else window_index + 1
            bundle = prepare_windows(values, ALPHA_INPUT_LENGTH, 1, requested_windows)
            stm = STM().fit(bundle["train_scaled"])
            selected_index = window_index
            if selected_index is None:
                selected_index = next((i for i, history in enumerate(bundle["histories"]) if np.any(np.diff(stm.transform_codes(history)))), 0)
            sequence = bundle["histories"][selected_index]
            table = describe_symbolic_transitions(stm, sequence)
            origin = int(bundle["origins"][selected_index])
            table.insert(0, "dataset", dataset_name)
            table.insert(1, "forecast_origin", origin)
            table.insert(2, "source_position", np.arange(origin - len(sequence), origin))
            table.insert(4, "value", inverse_scale(sequence, bundle["mean"], bundle["scale"]))
            table["test_window_index"] = selected_index
            profiles[dataset_name] = table
            destination = OUTPUT_DIRECTORY / f"{dataset_name}_alpha.csv"
            table.to_csv(destination, index=False)
            paths.append(str(destination))
        except Exception as exc:
            errors.append({"dataset": dataset_name, "error": safe_error(exc)})
    if profiles:
        figure = plot_symbolic_profiles(profiles)
        for extension in ("png", "pdf"):
            destination = OUTPUT_DIRECTORY / f"alpha_profiles.{extension}"
            figure.savefig(destination, dpi=200, bbox_inches="tight")
            paths.append(str(destination))
        plt.show()
        plt.close(figure)
        columns = ["dataset", "step", "previous_symbol", "symbol", "delta", "periodic_weight", "alpha_raw", "alpha_normalized"]
        for table in profiles.values():
            display(table.loc[table["alpha_raw"] > 0, columns].sort_values(["alpha_raw", "step"], ascending=[False, True]).head(10).reset_index(drop=True))
    return {
        "status": "ok" if profiles and not missing and not errors else "partial" if profiles else "configuration_required",
        "datasets": list(profiles),
        "window_selection": "first_window_with_symbolic_change" if window_index is None else "specified_window",
        "missing_datasets": missing,
        "errors": errors,
        "files": paths,
    }


